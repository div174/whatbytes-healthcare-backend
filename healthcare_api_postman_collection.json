    {
      "name": "5. Security & Edge Case Tests",
      "item": [
        {
          "name": "Access Protected API Without Token (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Verifies that unauthenticated requests to protected endpoints return HTTP 401 Unauthorized."
          }
        },
        {
          "name": "Register Duplicate Email (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Verifies duplicate email prevention returning HTTP 400 Bad Request."
          }
        },
        {
          "name": "Retrieve Non-Existent or Another User's Patient (Expect 404)",
